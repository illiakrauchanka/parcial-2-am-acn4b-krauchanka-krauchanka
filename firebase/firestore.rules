rules_version = '2';

// MedTraveler Firestore security rules.
//
// Data model:
//   users/{uid}/myMeds/{medId}   — private per-user list of saved medicines.
//
// Principle: a user may only read/write their OWN subcollection. The public
// medicine catalog lives in Realtime Database (see database.rules.json), not
// here, so Firestore holds only private per-user data.

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user saved medicines: only the owner (authenticated, matching uid).
    match /users/{uid}/{document=**} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow write:  if request.auth != null && request.auth.uid == uid;
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
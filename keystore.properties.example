# Copy this file to keystore.properties (gitignored) and fill in your release
# keystore details. keystore.properties itself is NEVER committed.
#
# 1. Generate a release key (once, keep it forever — losing it means you can't
#    publish updates):
#       keytool -genkey -v -keystore release.jks -alias medtraveler \
#               -keyalg RSA -keysize 2048 -validity 10000
# 2. Get the SHA-1 / SHA-256 of that keystore and register them in Firebase
#       Console -> Project settings -> Android app -> Add fingerprint:
#       keytool -list -v -keystore release.jks
# 3. Regenerate app/google-services.json from the Firebase Console so Google
#       Sign-In works with the release certificate.
# 4. Run: ./gradlew bundleRelease   (produces app-release.aab for Play Console)

storeFile=release.jks
storePassword=__CHANGE_ME__
keyAlias=medtraveler
keyPassword=__CHANGE_ME__
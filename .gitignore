# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# Gradle wrapper jar MUST be committed so CI can run ./gradlew without a local
# Gradle install. Exempt it from the *.jar rule above.
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Android / Gradle
/build
/.gradle
/.idea
/captures
.externalNativeBuild
.cxx
local.properties
*.iml

# OS
.DS_Store
Thumbs.db

# Assignment PDF (kept locally only)
parcial_01.pdf

# Release signing keys and signing config (never commit)
keystore.properties
# keystore.properties.example IS committable (template only)
*.keystore
*.jks
/release.jks

# Firebase project config (contains API key, OAuth client IDs, certificate
# hashes). Each developer regenerates it from the Firebase Console locally.
app/google-services.json
app/release/google-services.json

# Build artefacts and stray local dirs (never commit)
/dist/
/campus/

# catalog updater artifacts (never commit)
tools/cache/
tools/out/

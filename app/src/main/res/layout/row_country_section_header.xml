<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="@dimen/padding_section" android:paddingBottom="@dimen/spacing_medium">
    <ImageView android:id="@+id/img_flag"
        android:layout_width="32dp" android:layout_height="@dimen/flag_size"
        android:contentDescription="@string/cd_flag" android:scaleType="fitCenter"/>
    <TextView android:id="@+id/txt_country"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium" android:textSize="@dimen/text_size_section"
        android:textStyle="bold" android:textColor="@color/color_primary"/>
    <TextView android:id="@+id/txt_meta"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium" android:textSize="@dimen/text_size_caption"
        android:textColor="@color/text_secondary"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="@dimen/padding_card" android:background="@drawable/bg_quote"
    android:layout_marginBottom="@dimen/spacing_medium">
    <TextView android:id="@+id/txt_name"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="@dimen/text_size_body" android:textColor="@color/text_primary"/>
    <Button android:id="@+id/btn_remove"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/welcome_remove_country" style="?attr/borderlessButtonStyle"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/padding_screen"
    android:background="@color/surface">
    <EditText android:id="@+id/edit_search"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/medicine_search_hint" android:inputType="text"
        android:autofillHints=""/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/results_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="@dimen/spacing_medium"/>
    </ScrollView>
</LinearLayout>
